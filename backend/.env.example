# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=diplom_db
DB_USER=diplom_user
DB_PASSWORD=diplom_password
DB_HOST=db
DB_PORT=5432

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# FAISS
FAISS_INDEX_PATH=faiss_index

# Postgres container (used by docker-compose for the db service)
POSTGRES_DB=diplom_db
POSTGRES_USER=diplom_user
POSTGRES_PASSWORD=diplom_password
